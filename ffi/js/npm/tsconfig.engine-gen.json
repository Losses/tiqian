{
  "compilerOptions": {
    "target": "es2022",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "rewriteRelativeImportExtensions": true,
    "noEmit": false,
    "skipLibCheck": true,
    "outDir": "runtime/engine-gen",
    "rootDir": "engine-gen"
  },
  "include": ["engine-gen/**/*.ts"]
}
