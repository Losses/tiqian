{
  // Local compiler configuration for the vendored boring-generated tree
  // (engine-gen/). This is the ONLY place the strict relaxation may live
  // (Stage1-C gate ruling): the generated FontRoleContext constructor has an
  // optional parameter against a non-optional field
  // (ffi/js/npm/engine-gen/org/tiqian/font/FontRoleContext.ts:10-13), which
  // strict null checks reject as TS2322
  // ("Type 'string | null | undefined' is not assignable to type
  // 'string | null'"). The generated files are not hand-editable, so the
  // relaxation stays bounded to this directory's own configuration.
  //
  // Exit condition: the T1/T2 lines (milestone "非 Rust 目标警告清零与 boring
  // 基线转绿": tiqian TypeScript strict-level zero-warning gate and boring's
  // own TypeScript strict gate) — once those land and the emitter emits
  // strict-clean constructors, remove strictNullChecks: false and re-verify
  // this compile with strict on.
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "strict": true,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "declaration": false,
    "sourceMap": false,
    "rootDir": ".",
    "outDir": "../runtime/engine-gen"
  },
  "include": ["**/*.ts"]
}
