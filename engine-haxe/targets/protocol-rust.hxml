# Stage A protocol Rust generation entry (canonical byte form only).
# Run from the worktree root:
#   nix develop -c bash -c 'haxe engine-haxe/targets/protocol-rust.hxml'
# Shared compiler configuration for every engine-haxe generation entry.
-lib reflaxe
-lib boring
-cp .haxelib/boring/git/samples
-cp engine-haxe/src
-cp engine-haxe/macros
--macro haxe.macro.Compiler.addGlobalMetadata('org.tiqian', '@:build(std.RecordMember.build())')
-cp .haxelib/boring/git/packages/compiler
-cp .haxelib/boring/git/samples
-cp .haxelib/boring/git/packages/compiler/reflaxe/rust/std-shadow
-cp .haxelib/boring/git/packages/compiler/reflaxe/rust
--macro Intercept.run(['engine-haxe/src', '.haxelib/boring/git/samples'])
--macro rustcompiler.Compiler.use()
-D runtime-import=crate::runtime
-D runtime-emit=runtime
-D package-name=tiqian-protocol-gen
-D package-license=MIT
org.tiqian.protocol.WireValue
org.tiqian.protocol.Canonical
org.tiqian.protocol.ParagraphRequest
org.tiqian.protocol.ParagraphRequestTest
org.tiqian.protocol.NamedError
org.tiqian.protocol.NamedErrorTest
runtime.SortedTable
runtime.UString
std.UStringException