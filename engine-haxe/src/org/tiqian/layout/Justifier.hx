  function preferredGlue(k:InlineObjectPreferredStretchKind):GlueKind return switch(k){case PunctuationTrailing:GlueKind.InlineObjectPunctuationTrailing;case Relation:GlueKind.InlineObjectRelation;case BinaryOperator:GlueKind.InlineObjectBinaryOperator;};
  function preferredReason(k:InlineObjectPreferredStretchKind):String return switch(k){case PunctuationTrailing:"InlineObjectPunctuationTrailing";case Relation:"InlineObjectRelation";case BinaryOperator:"InlineObjectBinaryOperator";};
  function addTier(kind:GlueKind,priority:Int,capacity:Float,reason:String,pred:Int->Bool):Void { if(rem<=0||capacity<=0)return; final opp:Array<JustificationOpportunity>=[]; var j=lineClusterRange.start; while(j<lineClusterRange.end){if(pred(j)&&!isClosed(j,j+1))opp.push(new JustificationOpportunity(j,kind,priority,capacity,reason));j++;} allocate(opp,reason,capacity); }
  function allocate(opp:Array<JustificationOpportunity>,reason:String,cap:Float):Void {if(opp.length==0)return; var total=0.0; var oi=0; while(oi<opp.length){total+=opp[oi].capacity;oi++;} if(total<=0)return;final f=Math.min(1,rem/total);oi=0;while(oi<opp.length){final o=opp[oi];final d=o.capacity*f;if(d>0)out.push(new JustificationAllocation(o.targetClusterIndex,o.kind,o.priority,d,o.reason==null?reason:o.reason));oi++;}rem-=total*f;}
  final tech=technicalBoundaryAfterClusters; addTier(GlueKind.ProgressiveTechnical,0,progressiveTechnicalWhitespaceStretchCapacity(fontSize),"ProgressiveTechnicalWhitespaceStretch",function(j){return tech!=null&&tech.get(j)==ProgressiveBreakTier.Whitespace&&StringTools.trim(adjustedClusters[j].text)=="";});
  addTier(GlueKind.WordSpace,0,Math.max(wordSpaceMaxEm*fontSize,0),"WordSpace",function(j){return j>0&&j<adjustedClusters.length-1&&adjustedClusters[j].text!=""&&StringTools.trim(adjustedClusters[j].text)==""&&eastAsianSpacingEdges[j-1].trailing==EastAsianSpacingValue.Narrow&&eastAsianSpacingEdges[j+1].leading==EastAsianSpacingValue.Narrow&&adjustedClusters[j].advance>0;});
