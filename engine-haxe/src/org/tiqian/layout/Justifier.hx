  var pref=preferredInlineObjectBoundaryAfterClusters; if(pref!=null){var keys=pref.keys(); var ki=0; while(ki<keys.length){var key=keys[ki];var p=pref.get(key);if(p!=null&&key>=lineClusterRange.start&&key<lineClusterRange.end&&!isClosed(key,key+1))allocate([new JustificationOpportunity(key,preferredGlue(p.kind),2,p.capacity,preferredReason(p.kind))],preferredReason(p.kind),0);ki++;}}
  var hasCjk=false; i=lineClusterRange.start;while(i<=lineClusterRange.end){if(i>=0&&i<eastAsianSpacingEdges.length&&eastAsianSpacingEdges[i].containsWide)hasCjk=true;i++;}
  if(rem>0&&(hasCjk||uniform.size()>0)){addTier(GlueKind.CjkInterChar,3,rem,"CjkInterChar",function(j){return (clusterRoles[j]==FontRole.CjkText||clusterRoles[j]==FontRole.CjkPunctuation)&&(clusterRoles[j+1]==FontRole.CjkText||clusterRoles[j+1]==FontRole.CjkPunctuation)||isWideNarrow(eastAsianSpacingEdges[j].trailing,eastAsianSpacingEdges[j+1].leading)||bracket.has(j)||virtual.exists(j)&&!uniform.has(j);});}
  return new JustificationPlan(lineClusterRange,out,deficit,Math.max(rem,0),rem>0&&!hasCjk?"WesternDominantLineNaturalSpacing":null);
 }
 public function compress(surplus:Float,shrinkOpportunities:Array<ShrinkOpportunity>):CompressionPlan {if(surplus<=0)return new CompressionPlan([],surplus,0);var rem=surplus;final out:Array<PushInAllocation>=[];var a=shrinkOpportunities.filter(function(x)return x.capacity>0);var tier=-1;var group:Array<ShrinkOpportunity>=[];function flush():Void{if(group.length==0)return;var total=0.0;var gi=0;while(gi<group.length){total+=group[gi].capacity;gi++;}var f=Math.min(1,rem/total);gi=0;while(gi<group.length){var o=group[gi];var d=o.capacity*f;if(d>0)out.push(new PushInAllocation(o.clusterIndex,d,o.capacity,o.channel));gi++;}rem-=total*f;group=[];}var ai=0;while(ai<a.length){var o=a[ai];if(tier>=0&&o.tier!=tier){flush();if(rem<=0)break;}tier=o.tier;group.push(o);ai++;}flush();return new CompressionPlan(out,surplus,Math.max(rem,0));}
}
function eastAsianSpacingValue(x:EastAsianSpacingValue):EastAsianSpacingValue return x;
function isWideNarrow(a:EastAsianSpacingValue,b:EastAsianSpacingValue):Bool return (a==EastAsianSpacingValue.Wide&&b==EastAsianSpacingValue.Narrow)||(a==EastAsianSpacingValue.Narrow&&b==EastAsianSpacingValue.Wide);
