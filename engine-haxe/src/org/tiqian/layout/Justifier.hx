  if(clusterRoles.length!=adjustedClusters.length) throw new org.tiqian.core.TiqianIllegalArgumentException(org.tiqian.core.TextRangeError.Message("clusterRoles must align with adjustedClusters.")); if(eastAsianSpacingEdges.length!=adjustedClusters.length) throw new org.tiqian.core.TiqianIllegalArgumentException(org.tiqian.core.TextRangeError.Message("East_Asian_Spacing values must align with adjustedClusters."));
  var width=0.0; var i=lineClusterRange.start; while(i<=lineClusterRange.end){if(i>=0&&i<adjustedClusters.length)width+=adjustedClusters[i].advance;i++;} final deficit=Math.max(maxWidth-width,0); if(skip||deficit<=0)return new JustificationPlan(lineClusterRange,[],deficit,deficit,skip?skipReason:null);
  var rem=deficit; final out:Array<JustificationAllocation>=[];
