 public static function from(cs:Array<Cluster>,atoms:Array<PunctuationAtom>,plan:PunctuationSpacingCompressionResult):PunctuationGeometryLedger {final g=SortedMap.builder();for(i in 0...cs.length){final aa=atoms.filter(x->isInside(x.range,cs[i].range));if(aa.length>0){final body=aa.map(x->x.bodyWidth).sumOfFloat(x->x);g.put(i,new PunctuationClusterGeometry(cs[i].range,cs[i].text,cs[i].displayText,cs[i].advance,body,aa[0].leadingGlue.natural,aa[aa.length-1].trailingGlue.natural,aa[0].leadingGlueInitiallyConsumed,aa[aa.length-1].trailingGlueInitiallyConsumed,aa.length==1?aa[0].glyphInlineShift:0,aa.length==1?aa[0].glyphPlacementReason:null,aa.length==1?aa[0].anchor:null,aa[0].geometrySource));}}final bb=SortedMap.builder();for(k in g.keys()){final z=g.get(k);bb.put(k,new GlueBudget(z.leadingGlueNatural,z.leadingGlueInitiallyConsumed,z.trailingGlueNatural,z.trailingGlueInitiallyConsumed));}return new PunctuationGeometryLedger(cs,g,bb).consumeSpacing(plan);}
