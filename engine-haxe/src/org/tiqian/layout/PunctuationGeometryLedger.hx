 public function consumeLineEdgeGlue(lines:Array<LineCandidate>,?force:Null<Bool>):LineEdgeTrimResult{if(lines.length==0||budgets.size()==0)return new LineEdgeTrimResult(this,[]);final lead=SortedMap.builder();final trail=SortedMap.builder();final ds:Array<LineEdgeTrimDecisionInfo>=[];final forceEnd=force==null?true:force;for(line in lines){if(line.clusterRange.start>line.clusterRange.end)continue;final idx=line.clusterRange.end;if(forceEnd&&budgets.has(idx)){final q=budgets.get(idx);if(q.trailingRemaining>0){trail.put(idx,q.trailingRemaining);ds.push(new LineEdgeTrimDecisionInfo(line.sourceRange,naturalClusters[idx].range,"trailing",q.trailingRemaining,q.trailingConsumed,q.trailingNatural,"LineEndHalfWidthPunctuation"));}}final st=line.clusterRange.start;if(budgets.has(st)){final q=budgets.get(st);if(q.leadingRemaining>0){lead.put(st,q.leadingRemaining);ds.push(new LineEdgeTrimDecisionInfo(line.sourceRange,naturalClusters[st].range,"leading",q.leadingRemaining,q.leadingConsumed,q.leadingNatural,"LineStartHalfWidthPunctuation"));}}}return new LineEdgeTrimResult(consumeLeadingByCluster(lead).consumeTrailingByCluster(trail),ds);}
