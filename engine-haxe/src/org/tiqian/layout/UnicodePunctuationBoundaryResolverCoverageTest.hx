class UnicodePunctuationBoundaryResolverCoverageSupport {
 public static function start(n:String):Void new TestTraceRecorder("UnicodePunctuationBoundaryResolverCoverageTest").section(n);
 public static function clusters(t:String, cjk:Bool):Array<Cluster> { var a:Array<Cluster>=[]; var i=0; while(i<t.length){var s=t.substring(i,i+1);a.push(new Cluster(new TextRange(i,i+1),s,cjk?"cjk":"latin",cjk?16.0:8.0));i++;}return a;}
 public static function roles(t:String,cjk:Bool):Array<FontRole>{var a:Array<FontRole>=[];var i=0;while(i<t.length){a.push(cjk?FontRole.CjkText:FontRole.LatinText);i++;}return a;}
 public static function edges(n:Int):Array<EastAsianSpacingEdges>{var a:Array<EastAsianSpacingEdges>=[];var i=0;while(i<n){a.push(new EastAsianSpacingEdges(EastAsianSpacingValue.Wide,EastAsianSpacingValue.Wide,false));i++;}return a;}
 public static function mapText(m:std.SortedMap<Int,Int>):String {var s="{";var i=0;while(i<m.size()){if(i>0)s+=", ";s+=m.keyAt(i)+"="+m.get(m.keyAt(i));i++;}return s+"}";}
 public static function surrogate(c:Array<Int>):String {var s="";var i=0;while(i<c.length){s+=String.fromCharCode(c[i]);i++;}return s;}
}

